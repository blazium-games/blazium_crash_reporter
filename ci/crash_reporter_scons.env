# Sidecar-minimal SCons flags (sourced by CI).
# Philosophy: modules_enabled_by_default=no + explicit allowlist only.
# No Hub identity (hub_build / template_app_id / crash-analytics bake-ins / Hub IPC).

# Editor: lto=none (MSVC LTCG can exceed LNK1248 on editor.lib).
# Template: lto=full in CR_SCONS_TEMPLATE (not thin — needs LLVM).
CR_SCONS_COMMON="modules_enabled_by_default=no deprecated=no minizip=no tests=no debug_symbols=no optimize=size lto=none vulkan=no d3d12=no openxr=no opengl3=yes module_mono_enabled=no module_luau_module_enabled=no module_gdscript_enabled=yes module_freetype_enabled=yes module_text_server_fb_enabled=yes module_text_server_adv_enabled=no module_svg_enabled=yes module_mbedtls_enabled=yes module_regex_enabled=yes"

# Appended only for the export-tool editor. CI appends editor_build_id=<nightly SHA>.
CR_SCONS_EDITOR=""

# Appended only for target=template_release (shipped sidecar).
# CI appends template_build_id=<sidecar version>.
CR_SCONS_TEMPLATE="disable_3d=yes lto=full"
